<!DOCTYPE html>
<html lang="{{ lang or 'en' }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.goatcounter.com; font-src 'self'; connect-src 'self' https://*.goatcounter.com; form-action 'self'; base-uri 'self'; object-src 'none'">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description or 'Sustainable sourcing, Slow Food coffee & climate-resilient Liberica/Excelsa projects for specialty coffee from Uganda. Direct trade from East Africa to Europe.' }}">
  {% if page.url %}<link rel="canonical" href="https://zuricaf.com{{ page.url }}">{% endif %}
  {% if noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
  {%- set pageLang = lang or 'en' %}
  {%- set canonicalUrl = 'https://zuricaf.com' + page.url if page.url else '' %}
  {%- set ogImg = ogImage or '/images/hero.png' %}
  {%- set ogImgAbs = ogImg if ogImg.startsWith('http') else 'https://zuricaf.com' + ogImg %}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Zuricaf">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description or 'Sustainable sourcing, Slow Food coffee & climate-resilient Liberica/Excelsa projects for specialty coffee from Uganda. Direct trade from East Africa to Europe.' }}">
  {% if page.url %}<meta property="og:url" content="{{ canonicalUrl }}">{% endif %}
  <meta property="og:image" content="{{ ogImgAbs }}">
  <meta property="og:locale" content="{{ 'de_DE' if pageLang == 'de' else 'en_US' }}">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
  <link rel="stylesheet" href="/css/zuricaf.css">

  {% if page.url == '/' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Zuricaf",
    "url": "https://zuricaf.com/",
    "logo": "https://zuricaf.com/images/zuricaf.png",
    "email": "trade@zuricaf.com",
    "parentOrganization": {
      "@type": "Organization",
      "name": "tabme UG (haftungsbeschränkt)",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Diesterwegstr. 40",
        "postalCode": "33604",
        "addressLocality": "Bielefeld",
        "addressCountry": "DE"
      }
    },
    "location": [
      { "@type": "Place", "address": { "@type": "PostalAddress", "addressLocality": "Berlin", "addressCountry": "DE" } },
      { "@type": "Place", "address": { "@type": "PostalAddress", "addressLocality": "Kampala", "addressCountry": "UG" } }
    ],
    "areaServed": "Europe",
    "knowsAbout": ["green coffee", "Uganda coffee", "direct trade", "EUDR"],
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "sales",
      "email": "trade@zuricaf.com",
      "availableLanguage": ["de", "en"]
    }
  }
  </script>
  {% endif %}


  <script src="/js/lucide.min.js" defer></script>
  <script src="/js/site.js" defer></script>
  {% if page.url == "/" %}<script src="/js/direct-trade.js" defer></script>{% endif %}
</head>

{% set home_de = page.url == "/" %}
<body>

  <!-- ── Header ── -->
  <header class="site-header">
    <div class="header-inner">
      <a href="/">
        <img
          src="{{ header.logo | default('/images/zuricaf.png') }}"
          alt="{{ header.logo_alt | default('Zuricaf') }}"
          class="logo">
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        <ul>
          {% for item in header.links or [] %}
            {% if item.button %}
              <li><a href="{{ item.href }}" class="btn btn-outline"{% if home_de and de.home.nav[item.label] %} data-en="{{ item.label }}" data-de="{{ de.home.nav[item.label] }}"{% endif %}>{{ item.label }}</a></li>
            {% else %}
              <li><a href="{{ item.href }}"{% if home_de and de.home.nav[item.label] %} data-en="{{ item.label }}" data-de="{{ de.home.nav[item.label] }}"{% endif %}>{{ item.label }}</a></li>
            {% endif %}
          {% endfor %}
          {% if home_de %}<li><div class="lang" role="group" aria-label="Language / Sprache"><button type="button" data-set-lang="en" aria-pressed="true">EN</button><button type="button" data-set-lang="de" aria-pressed="false">DE</button></div></li>{% endif %}
        </ul>
      </nav>
    </div>
  </header>

  <!-- ── Page content ── -->
  {% if template %}
    {% include template %}
  {% else %}
    <main>
      <div class="wrapper section prose">
        {{ content | safe }}
      </div>
    </main>
  {% endif %}

  <!-- ── Footer ── -->
  <footer class="site-footer">
    <div class="wrapper">
      <div class="footer-links">
        {% for l in footer.links or [] %}
          <a href="{{ l.href }}">{{ l.label }}</a>
        {% endfor %}
      </div>
      <p style="margin-top:.75rem;opacity:.6;font-size:.8rem;">
        {{ footer.copyright or '© Zuricaf' }} {% year %}
      </p>
    </div>
  </footer>

  {% if site.goatcounter %}<script data-goatcounter="https://{{ site.goatcounter }}.goatcounter.com/count" async src="/js/count.js"></script>{% endif %}

</body>
</html>
