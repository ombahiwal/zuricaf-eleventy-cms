<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.goatcounter.com; font-src 'self'; connect-src 'self' https://*.goatcounter.com; form-action 'self'; base-uri 'self'; object-src 'none'">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} – Sortengold Blog</title>
  <meta name="description" content="{{ description or '' }}">
  {% if page.url %}<link rel="canonical" href="https://zuricaf.com{{ page.url }}">{% endif %}
  {% if noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
  {%- set pageLang = lang or 'de' %}
  {%- set canonicalUrl = 'https://zuricaf.com' + page.url if page.url else '' %}
  {%- set ogImg = ogImage or '/images/hero.png' %}
  {%- set ogImgAbs = ogImg if ogImg.startsWith('http') else 'https://zuricaf.com' + ogImg %}
  <meta property="og:type" content="article">
  <meta property="og:site_name" content="Zuricaf">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description or '' }}">
  {% if page.url %}<meta property="og:url" content="{{ canonicalUrl }}">{% endif %}
  <meta property="og:image" content="{{ ogImgAbs }}">
  <meta property="og:locale" content="{{ 'de_DE' if pageLang == 'de' else 'en_US' }}">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="stylesheet" href="/css/zuricaf.css">

</head>
<body>

  <!-- Header -->
  <header class="site-header">
    <div class="header-inner">
      <a href="/"><img src="{{ header.logo | default('/images/zuricaf.png') }}" alt="{{ header.logo_alt | default('Zuricaf') }}" class="logo"></a>
      <nav class="site-nav" aria-label="Main navigation">
        <ul>
          {% for item in header.links or [] %}
            {% if loop.last %}
              <li><a href="{{ item.href }}" class="btn" style="font-size:.82rem;padding:.4rem .9rem;">{{ item.label }}</a></li>
            {% else %}
              <li><a href="{{ item.href }}">{{ item.label }}</a></li>
            {% endif %}
          {% endfor %}
        </ul>
      </nav>
    </div>
  </header>

  <!-- Hero -->
  <section class="blog-hero">
    <div class="wrapper">
      <p class="section-label">Blog{% if category %} · {{ category }}{% endif %}</p>
      <h1>{{ title }}</h1>
      {% if subtitle %}<p class="subtitle">{{ subtitle }}</p>{% endif %}
      <p class="meta">
        <time datetime="{{ date | date('yyyy-MM-dd') }}">{{ date | date('d. MMMM yyyy') }}</time>
        {% if author %} · {{ author }}{% endif %}
      </p>
    </div>
  </section>

  <!-- Cover image -->
  {% if cover_image %}
  <div class="wrapper blog-cover">
    <figure>
      <img src="{{ cover_image }}" alt="{{ cover_image_alt | default(title) }}">
      {% if cover_image_caption %}<figcaption>{{ cover_image_caption }}</figcaption>{% endif %}
    </figure>
  </div>
  {% endif %}

  <!-- Body -->
  <article class="wrapper prose" style="max-width:720px;padding-block:3rem;">
    {{ content | safe }}
  </article>

  <!-- CTA -->
  <section style="background:var(--bg-warm);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding-block:3rem;">
    <div class="wrapper cta-block" style="max-width:600px;">
      <p class="section-label">Mehr erfahren</p>
      <h2>Qualität von der Quelle bis zur Tasse</h2>
      <p>Interesse an unseren Barista-Workshops in Berlin oder an direktem Handel mit ugandischen Kaffeebauern?</p>
      <div class="btn-group">
        <a href="/lot-info/" class="btn">Kaffee-Lots anfragen →</a>
        <a href="https://calendar.notion.so/meet/lorenzstckert/h932i4pxy" class="btn btn-outline" target="_blank" rel="noopener">Gespräch buchen</a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="wrapper">
      <div class="footer-links">
        {% for l in footer.links or [] %}
          <a href="{{ l.href }}">{{ l.label }}</a>
        {% endfor %}
      </div>
      <p style="margin-top:.75rem;opacity:.6;font-size:.8rem;">{{ footer.copyright or '© Zuricaf 2025' }}</p>
    </div>
  </footer>

  {% if site.goatcounter %}<script data-goatcounter="https://{{ site.goatcounter }}.goatcounter.com/count" async src="/js/count.js"></script>{% endif %}

</body>
</html>
