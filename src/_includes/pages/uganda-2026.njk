<!-- Partners -->
<section class="section">
  <div class="wrapper">
    <p class="section-label">Partners</p>
    <h2 style="margin-bottom:1.5rem;">Who's behind this trip</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1.25rem;">
      <div class="step">
        <h3 style="margin-bottom:.35rem;">German Embassy Kampala</h3>
        <p style="font-size:.875rem;color:var(--fg-mid);margin:0;">Co-organiser of the delegation, together with MAAIF — official diplomatic host on the ground in Uganda.</p>
      </div>
      <div class="step">
        <h3 style="margin-bottom:.35rem;">MAAIF</h3>
        <p style="font-size:.875rem;color:var(--fg-mid);margin:0;">Uganda's Ministry of Agriculture, Animal Industry and Fisheries — co-organiser, ministerial programme, and host of the final cupping session at the UCDA lab, Lugogo.</p>
      </div>
      <div class="step">
        <h3 style="margin-bottom:.35rem;">CCPAU</h3>
        <p style="font-size:.875rem;color:var(--fg-mid);margin:0;">Commercial Coffee Producers Association of Uganda — hosted the Day 2 cupping session, the format benchmark of the trip.</p>
      </div>
      <div class="step">
        <h3 style="margin-bottom:.35rem;">Zuricaf / Lorenz Stöckert</h3>
        <p style="font-size:.875rem;color:var(--fg-mid);margin:0;">Logistical coordination on the Uganda side, trade facilitation, German import &amp; customs coordination, key account management and quality assurance for the German roasters. Roasters purchase directly — Zuricaf never takes title to the goods.</p>
      </div>
    </div>
  </div>
</section>

