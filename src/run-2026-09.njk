<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Sammelcontainer Uganda → Hamburg · Run UG-GER-2026-09</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;800&family=Karla:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --paper:#EDEEE8; --paper-2:#E3E5DC; --ink:#1B211F; --slate:#5A6560;
  --jute:#C4A776; --jute-dk:#A8895A; --oxide:#A8432A; --line:#C9CCC3;
  --disp:'Archivo',system-ui,sans-serif; --body:'Karla',system-ui,sans-serif;
  --mono:'IBM Plex Mono',ui-monospace,monospace;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--paper);color:var(--ink);font-family:var(--body);font-size:16px;line-height:1.55;-webkit-font-smoothing:antialiased}
.wrap{max-width:1000px;margin:0 auto;padding:0 24px}
section{padding:64px 0;border-top:1px solid var(--line)}
section:first-of-type{border-top:none}

.eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--oxide);font-weight:600}
h1{font-family:var(--disp);font-weight:800;font-size:clamp(2.4rem,7vw,4.6rem);line-height:.95;letter-spacing:-.03em;margin:18px 0 20px;text-wrap:balance}
h1 em{font-style:normal;color:var(--oxide)}
h2{font-family:var(--disp);font-weight:800;font-size:clamp(1.4rem,3.4vw,2rem);letter-spacing:-.02em;line-height:1.05;margin-bottom:8px}
h3{font-family:var(--disp);font-weight:600;font-size:1rem;letter-spacing:-.01em;margin-bottom:6px}
.lead{font-size:clamp(1rem,2vw,1.15rem);max-width:56ch;color:var(--slate)}
.sec-note{font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--slate);margin-bottom:28px}

/* ---------- hero ---------- */
header{padding:44px 0 0}
.masthead{display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap;
  font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--slate);
  border-bottom:1px solid var(--line);padding-bottom:12px}

/* ---------- provisional-rate notice ---------- */
.provisional{font-family:var(--mono);font-size:12px;letter-spacing:.04em;color:var(--oxide);
  border:1px solid var(--oxide);padding:10px 14px;margin-top:18px;background:rgba(168,67,42,.05)}

/* ---------- tally / signature ---------- */
.calc{margin-top:40px;background:var(--paper-2);border:1px solid var(--line);padding:26px 22px 22px}
.calc-top{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;margin-bottom:18px}
.calc-top span{font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--slate)}
.tally{display:flex;gap:1px;height:56px;align-items:stretch;margin-bottom:2px}
.tally i{flex:1 1 auto;background:#D5D8CE;border-radius:1px;transition:background .18s ease}
.tally i.on{background:var(--jute)}
.tally i.edge{background:var(--jute-dk)}
@media (prefers-reduced-motion:reduce){.tally i{transition:none}}
.marks{position:relative;height:34px;margin-bottom:4px}
.mark{position:absolute;top:0;transform:translateX(-50%);text-align:center}
.mark b{display:block;width:1px;height:9px;background:var(--oxide);margin:0 auto 4px}
.mark span{font-family:var(--mono);font-size:9.5px;letter-spacing:.06em;color:var(--oxide);white-space:nowrap}
.calc-in{display:flex;gap:20px;flex-wrap:wrap;align-items:flex-end;border-top:1px solid var(--line);padding-top:18px}
.field-lg label{display:block;font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--slate);margin-bottom:6px}
.field-lg input{font-family:var(--mono);font-size:1.5rem;font-weight:500;width:150px;padding:8px 10px;
  background:var(--paper);border:1px solid var(--ink);color:var(--ink)}
.readout{display:flex;gap:26px;flex-wrap:wrap}
.ro b{display:block;font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--slate);font-weight:500;margin-bottom:4px}
.ro strong{font-family:var(--disp);font-weight:800;font-size:1.75rem;letter-spacing:-.02em;line-height:1}
.ro small{display:block;font-family:var(--mono);font-size:11px;color:var(--slate);margin-top:4px}
.ro.alert strong{color:var(--oxide)}

/* ---------- ledger ---------- */
table{width:100%;border-collapse:collapse;font-family:var(--mono);font-size:13.5px}
th{text-align:left;font-weight:600;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--slate);
  padding:0 10px 8px 0;border-bottom:1px solid var(--ink)}
td{padding:10px 10px 10px 0;border-bottom:1px solid var(--line)}
td.r,th.r{text-align:right;padding-right:0}
tr.hl td{background:rgba(196,167,118,.28)}

/* ---------- lists ---------- */
.cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:28px}
.inout{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:32px}
.inout ul{list-style:none;font-size:14.5px}
.inout li{padding:7px 0 7px 22px;position:relative;border-bottom:1px solid var(--line)}
.inout li::before{position:absolute;left:0;top:7px;font-family:var(--mono);font-size:13px}
.yes li::before{content:"+";color:var(--jute-dk)}
.no li::before{content:"–";color:var(--oxide)}

.steps{counter-reset:s;list-style:none}
.steps li{counter-increment:s;display:grid;grid-template-columns:44px 1fr;gap:16px;padding:16px 0;border-bottom:1px solid var(--line)}
.steps li::before{content:counter(s,decimal-leading-zero);font-family:var(--mono);font-size:12px;color:var(--oxide);padding-top:3px}
.steps p{font-size:14.5px;color:var(--slate)}

.terms{font-family:var(--mono);font-size:12.5px;line-height:1.75;color:var(--slate);columns:2;column-gap:40px}
.terms b{color:var(--ink);font-weight:600}
@media(max-width:640px){.terms{columns:1}}

/* ---------- form ---------- */
form{margin-top:28px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px}
.f{display:flex;flex-direction:column}
.f.full{grid-column:1/-1}
.f label{font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--slate);margin-bottom:6px}
.f input,.f select,.f textarea{font-family:var(--body);font-size:15px;padding:10px 12px;background:var(--paper);
  border:1px solid var(--line);color:var(--ink);border-radius:0}
.f textarea{min-height:90px;resize:vertical}
input:focus-visible,select:focus-visible,textarea:focus-visible,button:focus-visible,a:focus-visible{
  outline:2px solid var(--oxide);outline-offset:2px}
.check{display:flex;gap:10px;align-items:flex-start;font-size:13.5px;color:var(--slate);margin-top:22px}
.check input{margin-top:3px;accent-color:var(--oxide)}
button{margin-top:22px;font-family:var(--disp);font-weight:800;font-size:15px;letter-spacing:.01em;
  background:var(--ink);color:var(--paper);border:none;padding:15px 30px;cursor:pointer;transition:background .15s}
button:hover{background:var(--oxide)}
button:disabled{background:var(--line);color:var(--slate);cursor:not-allowed}
.msg{margin-top:18px;font-family:var(--mono);font-size:13px;padding:14px 16px;border:1px solid var(--oxide);color:var(--oxide);display:none}
.msg.show{display:block}
.msg.ok{border-color:var(--jute-dk);color:var(--ink)}
footer{padding:40px 0 60px;border-top:1px solid var(--ink);font-family:var(--mono);font-size:11.5px;color:var(--slate);
  display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}
a{color:var(--ink)}
</style>
</head>
<body>

<div class="wrap">

<header>
  <div class="masthead">
    <span>Zuricaf · Direct Trade Uganda</span>
    <span>Run UG-GER-2026-09 · Kampala → Hamburg</span>
  </div>

  <p class="eyebrow" style="margin-top:38px">Sammelcontainer · 20ft · 320 Sack à 60 kg</p>
  <h1>19.200 kg passen in einen Container.<br>Du brauchst <em>600</em>.</h1>
  <p class="lead">Wir konsolidieren einen Container ugandischen Rohkaffees nach Hamburg. Du buchst deine Menge, wir übernehmen Export, Fracht, Verzollung und Einlagerung. Was du zahlst, hängt davon ab, wie voll der Container wird — deshalb steht die ganze Rechnung hier offen.</p>

  <p class="provisional">Alle Raten vorläufig — endgültige Rate erst nach Bestätigung der Frachtkosten.</p>

  <div class="calc">
    <div class="calc-top">
      <span>Ein Strich = ein Sack à 60 kg</span>
      <span id="bagcount">0 von 320 Sack</span>
    </div>
    <div class="tally" id="tally" aria-hidden="true"></div>
    <div class="marks">
      <div class="mark" style="left:52.08%"><b></b><span>10 t · Mindestmenge</span></div>
      <div class="mark" style="left:78.13%"><b></b><span>15 t · Rebate</span></div>
      <div class="mark" style="left:88.54%"><b></b><span>17 t</span></div>
    </div>
    <div class="calc-in">
      <div class="field-lg">
        <label for="vol">Deine Menge in kg</label>
        <input type="number" id="vol" min="0" max="7000" step="60" value="1200" inputmode="numeric">
      </div>
      <div class="readout">
        <div class="ro" id="ro-rate"><b>Deine Rate</b><strong id="rate">–</strong><small id="tier">&nbsp;</small></div>
        <div class="ro"><b>Logistik gesamt</b><strong id="total">–</strong><small>zzgl. Zoll, EUSt, Cess</small></div>
        <div class="ro"><b>Anzahlung 30%</b><strong id="dep">–</strong><small>bei Buchung fällig</small></div>
      </div>
    </div>
  </div>
</header>

<section>
  <p class="sec-note">Warum es das gibt</p>
  <div class="cols">
    <div>
      <h3>Der Container ist die Hürde</h3>
      <p class="lead" style="font-size:15px">Ein eigenes Lot aus Uganda bekommst du nur, wenn du einen Container füllst. Die meisten Röstereien brauchen 600 bis 6.000 kg. Dazwischen gibt es nichts — außer den Importeur, der dir seine Auswahl verkauft.</p>
    </div>
    <div>
      <h3>Du behältst deinen Lieferanten</h3>
      <p class="lead" style="font-size:15px">Du kaufst den Kaffee selbst, bei dem Produzenten, den du willst. Wir treten nicht dazwischen und wir nehmen kein Eigentum an der Ware. Wir bewegen sie.</p>
    </div>
    <div>
      <h3>Eine Rate, keine Überraschungen</h3>
      <p class="lead" style="font-size:15px">Alles von der Sammelstelle in Uganda bis zum Lager in Hamburg steckt in einem Preis je Kilo. Was nicht drin ist, steht unten — vollständig und einzeln.</p>
    </div>
  </div>
</section>

<section>
  <p class="sec-note">Preisstaffel</p>
  <h2 style="margin-bottom:8px">Je mehr du buchst, desto weniger zahlst du je Kilo.</h2>
  <p class="provisional" style="margin:0 0 20px">Vorläufig — endgültige Rate erst nach Bestätigung der Frachtkosten.</p>
  <table>
    <thead><tr><th>Menge</th><th class="r">Rate €/kg</th><th class="r">bei 15 t Füllung</th><th class="r">bei 17 t Füllung</th></tr></thead>
    <tbody id="ladder"></tbody>
  </table>
  <p style="font-family:var(--mono);font-size:12px;color:var(--slate);margin-top:14px">
    Erreicht der Container 15.000 kg, bekommt jeder Teilnehmer 0,08 €/kg zurück. Ab 17.000 kg sind es 0,15 €/kg.
    Ausgezahlt nach der Verschiffung. Über 7.000 kg rechnen wir individuell.
  </p>
</section>

<section>
  <p class="sec-note">Leistungsumfang</p>
  <div class="inout">
    <div>
      <h3 style="margin-bottom:12px">In der Rate enthalten</h3>
      <ul class="yes">
        <li>Annahme an unserer Sammelstelle in Uganda</li>
        <li>Absacken, Screening, Exportmarkierung</li>
        <li>Exportabfertigung und Dokumentation</li>
        <li>Landtransport bis Mombasa</li>
        <li>Seefracht bis Hamburg</li>
        <li>Einfuhrabfertigung und Terminal Handling</li>
        <li>Entladung, Sortierung, Freilagerung</li>
      </ul>
    </div>
    <div>
      <h3 style="margin-bottom:12px">Nicht enthalten, zu Beleg</h3>
      <ul class="no">
        <li>Der Kaffee selbst — den kaufst du direkt</li>
        <li>Cess: 2% auf den deklarierten Exportwert</li>
        <li>Einfuhrzoll und Einfuhrumsatzsteuer</li>
        <li>Transportversicherung</li>
        <li>Lagerung über die Freiperiode hinaus</li>
        <li>Standgeld durch fehlende Papiere oder Zahlung</li>
      </ul>
    </div>
  </div>
</section>

<section>
  <p class="sec-note">Ablauf</p>
  <ol class="steps">
    <li><div><h3>Menge anmelden</h3><p>Formular unten. Du bekommst innerhalb von zwei Werktagen eine Bestätigung mit deiner Rate und dem Buchungsschluss.</p></div></li>
    <li><div><h3>Buchen und anzahlen</h3><p>30% Anzahlung. Damit ist dein Platz reserviert. Bis zum Buchungsschluss ist die Rate indikativ, danach fix.</p></div></li>
    <li><div><h3>Dein Lieferant liefert an</h3><p>An unsere Sammelstelle in Uganda, unverzollt und ohne Exportvorbereitung. Big Bags oder GrainPro. Eigene Jutesäcke mit deinem Logo kannst du leer schicken.</p></div></li>
    <li><div><h3>Wir sacken ab und verschiffen</h3><p>Absacken, Wiegen, Markieren, Export unter einer Anmeldung für den ganzen Container. Das verwogene Nettogewicht ist das Abrechnungsgewicht.</p></div></li>
    <li><div><h3>Abholung in Hamburg</h3><p>Nach Verzollung und Entladung bekommst du die Freimeldung. Ab da läuft deine Freilagerung.</p></div></li>
  </ol>
</section>

<section>
  <p class="sec-note">Bedingungen</p>
  <div class="terms">
    <p><b>Mindestmenge je Teilnehmer</b> 600 kg. Darüber in Schritten von 60 kg, also ganzen Sack.</p>
    <p><b>Der Container fährt ab 10.000 kg</b> gebuchtem Gesamtvolumen. Wird das nicht erreicht, kommt deine Anzahlung vollständig zurück und es entstehen dir keine Kosten.</p>
    <p><b>Raten sind indikativ bis zum Buchungsschluss</b> und danach fix — in beide Richtungen. Die veröffentlichte Staffel ist vorläufig, bis die Frachtkosten bestätigt sind.</p>
    <p><b>Zahlung</b> 30% bei Buchung, Rest vor Freistellung in Hamburg.</p>
    <p><b>Abrechnungsgewicht</b> ist das beim Absacken verwogene Nettogewicht, nicht die angemeldete Menge.</p>
    <p><b>Rebate</b> ab 15.000 kg 0,08 €/kg, ab 17.000 kg 0,15 €/kg, an alle Teilnehmer gleich.</p>
  </div>
</section>

<section id="form">
  <p class="sec-note">Anmeldung</p>
  <h2>Menge anmelden</h2>
  <p class="lead">Unverbindlich. Du bekommst deine Rate schriftlich bestätigt, bevor irgendetwas fällig wird.</p>

  <form id="booking" name="sammelcontainer" method="POST" data-netlify="true" netlify-honeypot="bot-field" novalidate>
    <input type="hidden" name="form-name" value="sammelcontainer">
    <input type="hidden" name="run" value="UG-GER-2026-09">
    <input type="hidden" name="rate" id="h-rate">
    <input type="hidden" name="logistik_gesamt" id="h-total">
    <input type="hidden" name="anzahlung_30" id="h-dep">
    <input type="hidden" name="sack" id="h-sack">
    <p style="display:none"><label>Bitte nicht ausfüllen: <input name="bot-field"></label></p>
    <div class="grid">
      <div class="f"><label for="firma">Rösterei / Firma</label><input id="firma" name="firma" required></div>
      <div class="f"><label for="name">Ansprechpartner</label><input id="name" name="ansprechpartner" required></div>
      <div class="f"><label for="mail">E-Mail</label><input id="mail" name="email" type="email" required></div>
      <div class="f"><label for="tel">Telefon</label><input id="tel" name="telefon" type="tel"></div>
      <div class="f"><label for="menge">Menge in kg</label><input id="menge" name="menge_kg" type="number" min="600" max="7000" step="60" required></div>
      <div class="f"><label for="pack">Anlieferung durch Lieferant</label>
        <select id="pack" name="anlieferung"><option>Big Bags</option><option>GrainPro</option><option>noch offen</option></select></div>
      <div class="f"><label for="jute">Eigene Jutesäcke mit Logo</label>
        <select id="jute" name="jutesaecke"><option>nein</option><option>ja, schicke ich leer</option><option>noch offen</option></select></div>
      <div class="f"><label for="lief">Lieferant / Exporteur</label><input id="lief" name="lieferant" placeholder="falls schon feststehend"></div>
      <div class="f full"><label for="lot">Lot, Aufbereitung, Region</label><input id="lot" name="lot" placeholder="z. B. Bugisu, Natural Anaerobic, 2 Lots à 600 kg"></div>
      <div class="f full"><label for="notes">Anmerkungen</label><textarea id="notes" name="anmerkungen" placeholder="Termine, Muster, offene Fragen"></textarea></div>
    </div>
    <label class="check"><input type="checkbox" id="ack" name="bedingungen_bestaetigt" value="ja" required>
      <span>Ich habe gelesen, dass der Container erst ab 10.000 kg Gesamtvolumen fährt, dass die Raten vorläufig sind bis die Frachtkosten bestätigt wurden, und dass Zoll, Einfuhrumsatzsteuer, Cess und Versicherung nicht in der Rate enthalten sind.</span></label>
    <button type="submit">Anmeldung senden</button>
    <div class="msg" id="msg"></div>
  </form>
</section>

<footer>
  <span>tabme UG (haftungsbeschränkt) · Zuricaf</span>
  <span><a href="mailto:lorenz@sortengold.de">lorenz@sortengold.de</a> · +49 160 3134000</span>
</footer>

</div>

<script>
const TIERS=[[600,999,1.60],[1000,1999,1.45],[2000,3499,1.32],[3500,4999,1.24],[5000,7000,1.18]];
const CAP=19200, BAGS=320, MAIL='lorenz@sortengold.de';
const eur=n=>n.toLocaleString('de-DE',{style:'currency',currency:'EUR',minimumFractionDigits:2});
const eur0=n=>n.toLocaleString('de-DE',{style:'currency',currency:'EUR',maximumFractionDigits:0});
const rateFor=kg=>{for(const[a,b,r]of TIERS){if(kg>=a&&kg<=b)return r;}return null;};

// ladder table
document.getElementById('ladder').innerHTML=TIERS.map(([a,b,r])=>
  `<tr data-lo="${a}" data-hi="${b}"><td>${a.toLocaleString('de-DE')} – ${b.toLocaleString('de-DE')} kg</td>
   <td class="r">${r.toFixed(2).replace('.',',')}</td>
   <td class="r">${(r-0.08).toFixed(2).replace('.',',')}</td>
   <td class="r">${(r-0.15).toFixed(2).replace('.',',')}</td></tr>`).join('');

// tally
const tally=document.getElementById('tally');
tally.innerHTML=Array.from({length:BAGS},()=>'<i></i>').join('');
const ticks=[...tally.children];

const vol=document.getElementById('vol');
function render(){
  const kg=Math.max(0,Math.min(CAP,Number(vol.value)||0));
  const bags=Math.round(kg/60);
  ticks.forEach((t,i)=>{t.className=i<bags?(i===bags-1?'on edge':'on'):'';});
  document.getElementById('bagcount').textContent=`${bags} von ${BAGS} Sack`;

  const r=rateFor(kg), ro=document.getElementById('ro-rate');
  if(!r){
    document.getElementById('rate').textContent='–';
    document.getElementById('tier').textContent=kg<600?'Minimum 600 kg':'über 7.000 kg — auf Anfrage';
    ro.classList.add('alert');
    document.getElementById('total').textContent='–';
    document.getElementById('dep').textContent='–';
    return;
  }
  ro.classList.remove('alert');
  document.getElementById('rate').textContent=r.toFixed(2).replace('.',',')+' €/kg';
  document.getElementById('tier').textContent=`${(r-0.15).toFixed(2).replace('.',',')} bei vollem Container`;
  document.getElementById('total').textContent=eur0(kg*r);
  document.getElementById('dep').textContent=eur0(kg*r*0.3);

  [...document.querySelectorAll('#ladder tr')].forEach(tr=>{
    tr.classList.toggle('hl',kg>=+tr.dataset.lo&&kg<=+tr.dataset.hi);
  });
}
vol.addEventListener('input',render);
render();

// form → Netlify, mailto als Fallback
const form=document.getElementById('booking');
form.addEventListener('submit',e=>{
  e.preventDefault();
  const g=id=>document.getElementById(id).value.trim();
  const msg=document.getElementById('msg');
  msg.classList.remove('ok');
  const kg=Number(g('menge'));
  if(!g('firma')||!g('name')||!g('mail')||!kg||!document.getElementById('ack').checked){
    msg.textContent='Bitte Firma, Ansprechpartner, E-Mail, Menge und die Bestätigung ausfüllen.';
    msg.classList.add('show');return;
  }
  if(kg<600||kg>7000){
    msg.textContent='Menge zwischen 600 und 7.000 kg. Größere Mengen bitte über eine kurze Mail.';
    msg.classList.add('show');return;
  }
  const r=rateFor(kg);
  document.getElementById('h-rate').value=r.toFixed(2).replace('.',',')+' €/kg (vorläufig)';
  document.getElementById('h-total').value=eur(kg*r);
  document.getElementById('h-dep').value=eur(kg*r*0.3);
  document.getElementById('h-sack').value=Math.round(kg/60);

  const btn=form.querySelector('button[type=submit]');
  btn.disabled=true;
  fetch('/',{
    method:'POST',
    headers:{'Content-Type':'application/x-www-form-urlencoded'},
    body:new URLSearchParams(new FormData(form)).toString()
  }).then(res=>{
    if(!res.ok)throw new Error('submit failed');
    msg.classList.add('ok');
    msg.textContent='Anmeldung eingegangen. Du bekommst innerhalb von zwei Werktagen eine Bestätigung mit deiner Rate.';
    msg.classList.add('show');
    form.reset();
    btn.disabled=false;
  }).catch(()=>{
    btn.disabled=false;
    const body=[
      'Anmeldung Sammelcontainer — Run UG-GER-2026-09','',
      'Rösterei: '+g('firma'),'Ansprechpartner: '+g('name'),
      'E-Mail: '+g('mail'),'Telefon: '+(g('tel')||'—'),'',
      'Menge: '+kg.toLocaleString('de-DE')+' kg ('+Math.round(kg/60)+' Sack)',
      'Rate laut Staffel (vorläufig): '+r.toFixed(2).replace('.',',')+' €/kg',
      'Logistik gesamt: '+eur(kg*r),
      'Anzahlung 30%: '+eur(kg*r*0.3),'',
      'Anlieferung: '+g('pack'),'Eigene Jutesäcke: '+g('jute'),
      'Lieferant: '+(g('lief')||'—'),'Lot: '+(g('lot')||'—'),'',
      'Anmerkungen: '+(g('notes')||'—'),'',
      'Bedingungen bestätigt: ja (Mindestvolumen 10.000 kg, Raten vorläufig, Zoll/EUSt/Cess/Versicherung nicht enthalten)'
    ].join('\n');
    window.location.href='mailto:'+MAIL+'?subject='+encodeURIComponent('Anmeldung Sammelcontainer — '+g('firma')+' — '+kg+' kg')+'&body='+encodeURIComponent(body);
    msg.textContent='Direktversand fehlgeschlagen — dein Mailprogramm öffnet sich mit der fertigen Anmeldung. Falls nicht: schick die Angaben an '+MAIL+'.';
    msg.classList.add('show');
  });
});
</script>
</body>
</html>
