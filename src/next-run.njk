<text x="54" y="145" class="g-sub">Landtransport, dann Verladung</text>
<circle cx="24" cy="230" r="15" class="g-dot"/>
<circle cx="24" cy="230" r="5" class="g-hub"/>
<text x="54" y="228" class="g-title">Hamburg</text>
<text x="54" y="245" class="g-sub">Seefracht, Einfuhrabfertigung, Lager</text>
<line x1="0" y1="268" x2="360" y2="268" class="g-rule"/>
<rect x="4" y="280" width="10" height="10" rx="3" class="g-chip"/>
