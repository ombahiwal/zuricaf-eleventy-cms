<circle cx="24" cy="30" r="15" class="g-dot"/>
<circle cx="24" cy="30" r="5" class="g-hub"/>
<text x="54" y="28" class="g-title">Kampala</text>
<text x="54" y="45" class="g-sub">Sammelstelle: Annahme, Absacken,</text>
<text x="54" y="61" class="g-sub">Markierung, Export</text>
<circle cx="24" cy="130" r="15" class="g-dot"/>
<circle cx="24" cy="130" r="5" class="g-hub"/>
