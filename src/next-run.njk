</svg>
    </div>
    <div>
      <h3>Vom Vormerken bis zur Abholung</h3>
      <svg class="gfx" viewBox="0 0 360 372" role="img" aria-labelledby="pt-n"><title id="pt-n">Ablauf von der Anmeldung bis zur Abholung</title>
<line x1="24" y1="34" x2="24" y2="322" class="g-line"/>
<circle cx="24" cy="34" r="15" class="g-dot"/>
<text x="24" y="39" class="g-num" text-anchor="middle">1</text>
<text x="54" y="31" class="g-title">Vormerken</text>
<text x="54" y="48" class="g-sub">Mail an uns, Antwort in zwei Werktagen</text>
<circle cx="24" cy="106" r="15" class="g-dot"/>
<text x="24" y="111" class="g-num" text-anchor="middle">2</text>
<text x="54" y="103" class="g-title">Bestätigung</text>
<text x="54" y="120" class="g-sub">Rate, Termin und Buchungsschluss schriftlich</text>
<circle cx="24" cy="178" r="15" class="g-dot"/>
<text x="24" y="183" class="g-num" text-anchor="middle">3</text>
<text x="54" y="175" class="g-title">Dein Lieferant liefert an</text>
<text x="54" y="192" class="g-sub">Sammelstelle Uganda, Big Bags oder GrainPro</text>
<circle cx="24" cy="250" r="15" class="g-dot"/>
<text x="24" y="255" class="g-num" text-anchor="middle">4</text>
